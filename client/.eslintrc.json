{
  "plugins": [
    "react"
  ],
  "extends": [
    "standard",
    "standard-jsx",
    "standard-react",
    "plugin:react/recommended"
  ],
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "requireConfigFile": false,
    "babelOptions": {
      "presets": ["@babel/preset-react"]
    },
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "settings": {
    "react": {
      "version": "16.14.0"
    }
  },
  "ignorePatterns": ["build/", "dist/", "node_modules/"],
  "rules": {}
}
